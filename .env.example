# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Long random strings, e.g. `openssl rand -hex 24`
INGEST_WEBHOOK_SECRET=
CRON_SECRET=

# --- Alerting ---
# log = print calls/SMS to the server console (safe for testing). live = real Africa's Talking calls/SMS.
NOTIFY_MODE=log
ESCALATION_SECONDS=60
OFFLINE_MINUTES=180
LOW_BATTERY_PCT=20
HEAT_ALARM_C=57
# Carbon monoxide level (ppm) that counts as an alarm for devices that only send readings
CO_ALARM_PPM=100

# --- Africa's Talking (only needed when NOTIFY_MODE=live) ---
AT_USERNAME=
AT_API_KEY=
AT_VOICE_NUMBER=+234XXXXXXXXXX
AT_SMS_SENDER=
# AT_ENV=sandbox

# --- NIPOST digital postcode (optional; format is checked offline without it) ---
# Key from the developer dashboard at postcode.gov.ng
NIPOST_API_KEY=
# 1 = valid/not, 2 adds state/LGA/address. NIPOST caps it at your key's level.
NIPOST_LOOKUP_LEVEL=2

# --- Telegram alerts (optional; not blocked by DND). Create a bot with @BotFather ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
