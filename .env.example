# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_URL=http://localhost:3000
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
# Long random strings, e.g. `openssl rand -hex 24`
INGEST_WEBHOOK_SECRET=
CRON_SECRET=

# --- Alerting ---
# log = print calls/SMS to the server console (safe for testing). live = real Africa's Talking calls/SMS.
NOTIFY_MODE=log
ESCALATION_SECONDS=60
OFFLINE_MINUTES=180
LOW_BATTERY_PCT=20
HEAT_ALARM_C=57

# --- Africa's Talking (only needed when NOTIFY_MODE=live) ---
AT_USERNAME=
AT_API_KEY=
AT_VOICE_NUMBER=+234XXXXXXXXXX
AT_SMS_SENDER=
# AT_ENV=sandbox
